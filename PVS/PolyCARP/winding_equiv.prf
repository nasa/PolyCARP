               quadrant(p(0)) - 4 * floor(quadrant(p(0)) / 4)
          THEN 1
        ELSIF quadrant(p(0)) - 1 =
               quadrant(p(1)) - 4 * floor(quadrant(p(1)) / 4)
          THEN -1
        ELSIF det(p(1) - p(0), p(0)) <= 0 THEN 2
        ELSE -2
        ENDIF=-2")
